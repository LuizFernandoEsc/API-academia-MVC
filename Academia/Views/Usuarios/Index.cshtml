@model List<UsuarioModel>
@{
    ViewData["Title"] = "Lista de usuarios no academia";
}
<div class="text-center">
    <div class="d-grid gap-2 d-md-flex justify-content-md-start">
        <a role="button" asp-controller="Usuarios" asp-action="Criar" class="btn btn-success">Adicionar usuario</a>

    </div>

    <br />
    <h1>Lista de usuarios</h1>
    <table class="table">
    <thead>
        <tr>
            <th scope="col">Matricula</th>
            <th scope="col">Nome</th>
            <th scope="col">Número</th>
            <th scope="col">CPF</th>
            <th scope="col">Plano</th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
            @if(Model != null && Model.Any())
            {
                foreach(UsuarioModel item in Model)
                {
                    <tr>
                        <th scope="row">@item.Id</th>
                        <td>@item.name</td>
                        <td>@item.numero</td>
                        <td>@item.cpf</td>
                        <td>@item.plano</td>     
                        <td>
                            <div class="btn-group" role="group">
                                <a role="button" asp-controller="Usuarios" asp-action="ConfirmarExcluir" asp-route-id="@item.Id" class="btn btn-danger">Excluir</a>
                                <a role="button" asp-controller="Usuarios" asp-action="Editar" asp-route-id="@item.Id" class="btn btn-warning">Editar</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
</table>
</div>

